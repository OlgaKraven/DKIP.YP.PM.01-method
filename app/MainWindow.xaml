<Window x:Class="CatalogDesk.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Каталог и календарная цена" Width="1080" Height="780" MinWidth="880" MinHeight="650" FontFamily="Calibri" FontSize="17" Background="White" Language="ru-RU">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20"><TextBlock x:Name="OrganizationTitle" Text="Каталог" FontSize="30" FontWeight="Bold"/><TextBlock Text="Цена зависит от заказов за предыдущий календарный месяц." Margin="0,6,0,0"/></StackPanel>
    <Border Grid.Row="1" Background="#D2F6E7" CornerRadius="10" Padding="16" Margin="0,0,0,16">
      <DockPanel LastChildFill="False"><Button DockPanel.Dock="Right" Content="Открыть данные…" Click="OpenData_Click" Background="White" BorderBrush="#427864" AutomationProperties.Name="Открыть данные"/>
        <StackPanel Orientation="Horizontal"><Label Content="Дата _расчёта" Target="{Binding ElementName=CalculationDate}" VerticalAlignment="Center"/>
          <DatePicker x:Name="CalculationDate" Width="150" VerticalContentAlignment="Center" Margin="8,0,12,0" SelectedDateChanged="Date_Changed" CalendarClosed="Date_CalendarClosed" DateValidationError="Date_Invalid" PreviewKeyDown="Date_Editing" AutomationProperties.Name="Дата расчёта"/>
          <Button Content="Пересчитать" Click="Recalculate_Click" Background="#70B2AF" BorderBrush="#427864" AutomationProperties.Name="Пересчитать"/></StackPanel>
      </DockPanel>
    </Border>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="ProductList"><ItemsControl.ItemTemplate><DataTemplate>
        <Border BorderBrush="#CFD8D4" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
          <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="White"/><Style.Triggers><DataTrigger Binding="{Binding IsLowStock}" Value="True"><Setter Property="Background" Value="#ff8080"/></DataTrigger></Style.Triggers></Style></Border.Style>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="205"/></Grid.ColumnDefinitions>
            <Border Width="100" Height="108" Background="#F1F4F2" BorderBrush="#A2B0A9" BorderThickness="1" CornerRadius="6" VerticalAlignment="Top"><Image Source="{Binding PlaceholderPath}" Stretch="Uniform" AutomationProperties.Name="Изображение товара отсутствует"/></Border>
            <StackPanel Grid.Column="1" Margin="0,0,18,0"><TextBlock Text="{Binding Card.Name}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock Text="{Binding Details}" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="{Binding Card.Description}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="{Binding StockText}" Margin="0,8,0,0" FontWeight="SemiBold"/><TextBlock Text="{Binding Card.Reason}" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="{Binding PeriodText}" TextWrapping="Wrap" FontSize="14" Margin="0,4,0,0"/></StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="Итоговая цена" FontSize="14"/><TextBlock Text="{Binding PriceText}" FontSize="29" FontWeight="Bold"/><TextBlock Text="{Binding BasePriceText}" FontSize="14" Margin="0,5,0,0"/><TextBlock Text="{Binding DiscountText}" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel>
          </Grid>
        </Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </ScrollViewer>
    <TextBlock Grid.Row="3" x:Name="Status" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="15" AutomationProperties.LiveSetting="Polite"/>
  </Grid>
</Window>
